<section class="dimancer-files-companion-form">
  <p class="hint">{{localize "DIMANCER_FILES.Companion.Explain"}} <a href="{{repo}}" target="_blank" rel="noopener">{{repo}}</a></p>
  <div class="form-group">
    <label>{{localize "DIMANCER_FILES.Companion.Url"}}</label>
    <div class="form-fields">
      <input type="text" name="url" value="{{url}}" placeholder="{{placeholder}}">
      <button type="button" data-action="test"><i class="fa-solid fa-plug"></i> {{localize "DIMANCER_FILES.Companion.Test"}}</button>
    </div>
    <p class="hint">{{localize "DIMANCER_FILES.Companion.UrlHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "DIMANCER_FILES.Companion.Status"}}</label>
    <div class="form-fields">
      {{#if status}}
        {{#if status.ok}}<span class="df-ok"><i class="fa-solid fa-circle-check"></i> {{localize "DIMANCER_FILES.Companion.Reachable"}}</span>
        {{else}}<span class="df-bad"><i class="fa-solid fa-circle-xmark"></i> {{status.error}}</span>{{/if}}
      {{else}}<span>—</span>{{/if}}
    </div>
  </div>

  {{#if session}}
  <div class="form-group">
    <label>{{localize "DIMANCER_FILES.Companion.Login"}}</label>
    <div class="form-fields">
      <span class="df-ok"><i class="fa-solid fa-lock-open"></i> {{localize "DIMANCER_FILES.Companion.LoggedIn" until=session.until version=session.version}}</span>
      <button type="button" data-action="logout"><i class="fa-solid fa-right-from-bracket"></i> {{localize "DIMANCER_FILES.Companion.Logout"}}</button>
    </div>
    <p class="hint">
      {{#if session.policy.permanent}}{{localize "DIMANCER_FILES.Companion.PolicyPermanent"}}{{else}}{{localize "DIMANCER_FILES.Companion.PolicyTrash"}}{{/if}}
      {{#if session.roots}} {{localize "DIMANCER_FILES.Companion.PolicyRoots" roots=session.roots}}{{/if}}
    </p>
  </div>
  {{else}}
  <div class="form-group">
    <label>{{localize "DIMANCER_FILES.Companion.Secret"}}</label>
    <div class="form-fields">
      <input type="password" name="secret" autocomplete="off" placeholder="{{localize "DIMANCER_FILES.Companion.SecretPlaceholder"}}">
      <button type="button" data-action="login"><i class="fa-solid fa-right-to-bracket"></i> {{localize "DIMANCER_FILES.Companion.LoginButton"}}</button>
    </div>
    <p class="hint">{{localize "DIMANCER_FILES.Companion.SecretHint"}}</p>
  </div>
  {{/if}}
</section>
